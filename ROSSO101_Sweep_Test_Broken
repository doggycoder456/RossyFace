def sysCall_joint():
    global current_angle
    for i in range(6):
        mpos_PID_control(joints[i], current_angle)
    if current_angle < target_angle:
        current_angle+=pi/180
    if current_angle > target_angle:
        current_angle = target_angle
    
         
