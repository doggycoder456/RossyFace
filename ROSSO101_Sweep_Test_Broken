def mpos_PID_control(joint,target_pos,reset_I=False):
    pTerm = 0
    global error_int
    vTerm = 0
    iTerm = 0
    index_joint = joints.index(joint)
    kp = constants_of_k[index_joint][0]
    kd = constants_of_k[index_joint][1]
    ki = constants_of_k[index_joint][2]
    error_t = target_pos- sim.getJointPosition(joint)
    error_vel = 0 - sim.getJointVelocity(joint)
    pTerm = error_t * kp
    vTerm = error_vel * kd
    if reset_I:
        error_int[index_joint] = 0
    else:
        error_int[index_joint] += error_t * sim.getSimulationTimeStep()
    if ki != 0 and  error_int[index_joint] < max_min_torque[index_joint]/ki:
        error_int[index_joint] = -max_min_torque[index_joint]/ki
    if ki != 0 and  error_int[index_joint] > max_min_torque[index_joint]/ki and ki != 0:
        error_int[index_joint] = max_min_torque[index_joint]/ki
    iTerm = error_int[index_joint] * ki
    torque = pTerm+vTerm+iTerm
    if torque > 3:
        torque = 3
    if torque < -3:
        torque = -3
    return sim.setJointTargetForce(joint,torque)
